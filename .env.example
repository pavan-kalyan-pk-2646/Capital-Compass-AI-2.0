# Capital Compass AI 2.0 — copy to .env (repo root). Everything is optional:
# with no .env at all the app runs on a local SQLite file with zero API keys.

# MySQL 8 (recommended). Create the database first, see README "MySQL setup".
# DATABASE_URL=mysql+pymysql://compass:compass@localhost:3306/capital_compass
DATABASE_URL=

# Signs login tokens. Leave empty to auto-generate one into backend/.secret_key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional language-model polish of the final summary paragraph only.
# none (default, no key) | ollama (local, no key) | openai (needs LLM_API_KEY)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
OLLAMA_URL=http://localhost:11434

PORT=5000
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market Intelligence: public RSS feeds (no keys). Leave empty for the built-in list.
# NEWS_FEEDS=https://www.rbi.org.in/pressreleases_rss.xml,https://feeds.bbci.co.uk/news/business/rss.xml
NEWS_FEEDS=
# Set to 0 to always use the labelled offline sample (e.g. for a demo without internet).
NEWS_LIVE=1
